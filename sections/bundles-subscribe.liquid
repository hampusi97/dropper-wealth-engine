<section class="bundles" id="bundles">
  <div class="section-head">
    <h2>Pick your tier</h2>
    <p>Buy more, ship free, keep the companion gift.</p>
  </div>
  <div class="bundle-grid">
    <article class="bundle" data-tier="1">
      <p class="bundle__tag">Starter</p>
      <p class="bundle__price">$59.00</p>
      <p class="bundle__sub">1 &times; SpineAlign 3-in-1 Heated Cervical Traction Cradle</p>
      <ul><li>Free digital add-on available at checkout</li><li>60-day guarantee</li></ul>
    </article>
    <article class="bundle bundle--feature" data-tier="2">
      <p class="bundle__tag">Duo &mdash; save 15%</p>
      <p class="bundle__price">$100.30</p>
      <p class="bundle__sub">2 &times; SpineAlign 3-in-1 Heated Cervical Traction Cradle</p>
      <ul><li>Free shipping</li><li>Save $17.70</li><li>Free digital add-on</li></ul>
    </article>
    <article class="bundle" data-tier="3">
      <p class="bundle__tag">Collector Vault &mdash; save 25%</p>
      <p class="bundle__price">$132.75</p>
      <p class="bundle__sub">3 &times; SpineAlign 3-in-1 Heated Cervical Traction Cradle</p>
      <ul><li>Free shipping</li><li>Save $44.25</li><li>Free companion gift</li></ul>
    </article>
  </div>
  <div class="subscribe-strip">
    <div>
      <h3>Subscribe &amp; Save 20%</h3>
      <p>Quarterly Ergonomic Cover &amp; Acupressure Kit &mdash; $25/quarter. Fresh washable cover quarterly. Cancel anytime.</p>
    </div>
    <a class="btn btn--primary" href="{{ routes.root_url }}products/spinealign-3-in-1-heated-cervical-traction-cradle?selling_plan=subscribe">Start the club</a>
  </div>
</section>
{% schema %}
{
  "name": "Bundle + subscribe tiers",
  "settings": []
}
{% endschema %}
