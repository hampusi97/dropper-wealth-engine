<section class="bundles" id="bundles">
  <div class="section-head">
    <h2>Pick your tier</h2>
    <p>Buy more, ship free, keep the companion gift.</p>
  </div>
  <div class="bundle-grid">
    <article class="bundle" data-tier="1">
      <p class="bundle__tag">Starter</p>
      <p class="bundle__price">$119.00</p>
      <p class="bundle__sub">1 &times; NomadCarry AirVac 40L Vacuum Backpack + Pump</p>
      <ul><li>Free digital add-on available at checkout</li><li>60-day guarantee</li></ul>
    </article>
    <article class="bundle bundle--feature" data-tier="2">
      <p class="bundle__tag">Duo &mdash; save 15%</p>
      <p class="bundle__price">$202.30</p>
      <p class="bundle__sub">2 &times; NomadCarry AirVac 40L Vacuum Backpack + Pump</p>
      <ul><li>Free shipping</li><li>Save $35.70</li><li>Free digital add-on</li></ul>
    </article>
    <article class="bundle" data-tier="3">
      <p class="bundle__tag">Collector Vault &mdash; save 25%</p>
      <p class="bundle__price">$267.75</p>
      <p class="bundle__sub">3 &times; NomadCarry AirVac 40L Vacuum Backpack + Pump</p>
      <ul><li>Free shipping</li><li>Save $89.25</li><li>Free companion gift</li></ul>
    </article>
  </div>
  <div class="subscribe-strip">
    <div>
      <h3>Subscribe &amp; Save 20%</h3>
      <p>Quarterly Modular Travel Organizer &amp; Tag Drop &mdash; $34/quarter. New modular organizer quarterly. Cancel anytime.</p>
    </div>
    <a class="btn btn--primary" href="{{ routes.root_url }}products/nomadcarry-airvac-40l-vacuum-backpack-pump?selling_plan=subscribe">Start the club</a>
  </div>
</section>
{% schema %}
{
  "name": "Bundle + subscribe tiers",
  "settings": []
}
{% endschema %}
