<section class="bundles" id="bundles">
  <div class="section-head">
    <h2>Pick your tier</h2>
    <p>Buy more, ship free, keep the companion gift.</p>
  </div>
  <div class="bundle-grid">
    <article class="bundle" data-tier="1">
      <p class="bundle__tag">Starter</p>
      <p class="bundle__price">$44.00</p>
      <p class="bundle__sub">1 &times; The Utah Reader &amp; Game Night Box</p>
      <ul><li>Free digital add-on available at checkout</li><li>60-day guarantee</li></ul>
    </article>
    <article class="bundle bundle--feature" data-tier="2">
      <p class="bundle__tag">Duo &mdash; save 15%</p>
      <p class="bundle__price">$74.80</p>
      <p class="bundle__sub">2 &times; The Utah Reader &amp; Game Night Box</p>
      <ul><li>Free shipping</li><li>Save $13.20</li><li>Free digital add-on</li></ul>
    </article>
    <article class="bundle" data-tier="3">
      <p class="bundle__tag">Collector Vault &mdash; save 25%</p>
      <p class="bundle__price">$99.00</p>
      <p class="bundle__sub">3 &times; The Utah Reader &amp; Game Night Box</p>
      <ul><li>Free shipping</li><li>Save $33.00</li><li>Free companion gift</li></ul>
    </article>
  </div>
  <div class="subscribe-strip">
    <div>
      <h3>Subscribe &amp; Save 20%</h3>
      <p>Monthly Utah Mystery Book &amp; Board Game Box &mdash; $36/month. One graded hardcover every month. Cancel anytime.</p>
    </div>
    <a class="btn btn--primary" href="{{ routes.root_url }}products/the-utah-reader-game-night-box?selling_plan=subscribe">Start the club</a>
  </div>
</section>
{% schema %}
{
  "name": "Bundle + subscribe tiers",
  "settings": []
}
{% endschema %}
