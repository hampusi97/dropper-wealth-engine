<section class="bundles" id="bundles">
  <div class="section-head">
    <h2>Pick your tier</h2>
    <p>Buy more, ship free, keep the companion gift.</p>
  </div>
  <div class="bundle-grid">
    <article class="bundle" data-tier="1">
      <p class="bundle__tag">Starter</p>
      <p class="bundle__price">$49.00</p>
      <p class="bundle__sub">1 &times; VerdeHydro 4000K Brass Halo Grow Light &amp; Planter</p>
      <ul><li>Free digital add-on available at checkout</li><li>60-day guarantee</li></ul>
    </article>
    <article class="bundle bundle--feature" data-tier="2">
      <p class="bundle__tag">Duo &mdash; save 15%</p>
      <p class="bundle__price">$83.30</p>
      <p class="bundle__sub">2 &times; VerdeHydro 4000K Brass Halo Grow Light &amp; Planter</p>
      <ul><li>Free shipping</li><li>Save $14.70</li><li>Free digital add-on</li></ul>
    </article>
    <article class="bundle" data-tier="3">
      <p class="bundle__tag">Collector Vault &mdash; save 25%</p>
      <p class="bundle__price">$110.25</p>
      <p class="bundle__sub">3 &times; VerdeHydro 4000K Brass Halo Grow Light &amp; Planter</p>
      <ul><li>Free shipping</li><li>Save $36.75</li><li>Free companion gift</li></ul>
    </article>
  </div>
  <div class="subscribe-strip">
    <div>
      <h3>Subscribe &amp; Save 20%</h3>
      <p>Monthly Organic Liquid Plant Food &amp; Hydro-Wick Refill &mdash; $18/month. 8 oz organic plant food. Cancel anytime.</p>
    </div>
    <a class="btn btn--primary" href="{{ routes.root_url }}products/verdehydro-4000k-brass-halo-grow-light-planter?selling_plan=subscribe">Start the club</a>
  </div>
</section>
{% schema %}
{
  "name": "Bundle + subscribe tiers",
  "settings": []
}
{% endschema %}
