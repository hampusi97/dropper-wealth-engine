<section class="hero" data-hero data-store="store-01-bizi-bees">
  <div class="hero__stage" data-hero-stage>
    <div class="hero__grid" aria-hidden="true"></div>
    <div class="hero__isometric" data-isometric>
      <div class="layer" data-depth="34" style="--i: 0">
        <span class="layer__index">01</span>
        <span class="layer__name">Hand-Graded Vintage Hardcover</span>
        <span class="layer__note">Grades A/B, spine-tested, no missing pages</span>
      </div>
      <div class="layer" data-depth="68" style="--i: 1">
        <span class="layer__index">02</span>
        <span class="layer__name">Verified Complete Board Game</span>
        <span class="layer__note">Every piece counted against the manual</span>
      </div>
      <div class="layer" data-depth="102" style="--i: 2">
        <span class="layer__index">03</span>
        <span class="layer__name">Solid Brass Page Anchor</span>
        <span class="layer__note">1.6 oz, machine-finished, felt-backed</span>
      </div>
      <div class="layer" data-depth="136" style="--i: 3">
        <span class="layer__index">04</span>
        <span class="layer__name">Utah Kraft Collector Box</span>
        <span class="layer__note">Rigid 12x9x3 mailer, recycled kraft</span>
      </div>
    </div>
  </div>
  <div class="hero__copy">
    <p class="hero__eyebrow">Hand-graded used books and 100%-complete board games, packed in Utah.</p>
    <h1 class="hero__title">{{ section.settings.heading | default: "The Utah Reader & Game Night Box" }}</h1>
    <p class="hero__lede">{{ section.settings.lede | default: "One hand-graded hardcover, one verified-complete board game, a solid brass page anchor, and a Utah kraft collector box." }}</p>
    <ul class="hero__callouts">
        <li><b>01</b> Hand-Graded Vintage Hardcover &mdash; Grades A/B, spine-tested, no missing pages</li>
        <li><b>02</b> Verified Complete Board Game &mdash; Every piece counted against the manual</li>
        <li><b>03</b> Solid Brass Page Anchor &mdash; 1.6 oz, machine-finished, felt-backed</li>
        <li><b>04</b> Utah Kraft Collector Box &mdash; Rigid 12x9x3 mailer, recycled kraft</li>
    </ul>
    <div class="hero__actions">
      <a class="btn btn--primary" href="{{ section.settings.cta_link | default: '/products/the-utah-reader-game-night-box' }}">Unlock the complete set &mdash; {{ section.settings.price | default: 44 }}</a>
      <a class="btn btn--ghost" href="#bundles">Compare 3 tiers</a>
    </div>
    <p class="hero__meta">Ships from {{ shop.name }} &bull; 60-day guarantee &bull; Subscribe &amp; save 20%</p>
  </div>
</section>
{% schema %}
{
  "name": "3D exploded hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Utah Reader & Game Night Box" },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "One hand-graded hardcover, one verified-complete board game, a solid brass page anchor, and a Utah kraft collector box." },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "number", "id": "price", "label": "Hero price (USD)", "default": 44 }
  ]
}
{% endschema %}
