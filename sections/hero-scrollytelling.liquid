<section class="hero" data-hero data-store="store-04-sculpt-wave">
  <div class="hero__stage" data-hero-stage>
    <div class="hero__grid" aria-hidden="true"></div>
    <div class="hero__isometric" data-isometric>
      <div class="layer" data-depth="34" style="--i: 0">
        <span class="layer__index">01</span>
        <span class="layer__name">40kHz Ultrasonic Head</span>
        <span class="layer__note">40,000 cycles/sec, 2.6 in contact face</span>
      </div>
      <div class="layer" data-depth="68" style="--i: 1">
        <span class="layer__index">02</span>
        <span class="layer__name">3-Intensity Control Dial</span>
        <span class="layer__note">Low / mid / high with LED ring</span>
      </div>
      <div class="layer" data-depth="102" style="--i: 2">
        <span class="layer__index">03</span>
        <span class="layer__name">15-Minute Auto Timer</span>
        <span class="layer__note">One zone per session</span>
      </div>
      <div class="layer" data-depth="136" style="--i: 3">
        <span class="layer__index">04</span>
        <span class="layer__name">Conductive Gel Starter</span>
        <span class="layer__note">8 oz botanical firming gel</span>
      </div>
    </div>
  </div>
  <div class="hero__copy">
    <p class="hero__eyebrow">At-home 40kHz ultrasonic cavitation and contouring tools with a real protocol.</p>
    <h1 class="hero__title">{{ section.settings.heading | default: "SculptWave 40kHz Ultrasonic Body Sculptor" }}</h1>
    <p class="hero__lede">{{ section.settings.lede | default: "A 40kHz ultrasonic head with a 3-intensity dial, a 15-minute auto session timer, and a conductive gel starter." }}</p>
    <ul class="hero__callouts">
        <li><b>01</b> 40kHz Ultrasonic Head &mdash; 40,000 cycles/sec, 2.6 in contact face</li>
        <li><b>02</b> 3-Intensity Control Dial &mdash; Low / mid / high with LED ring</li>
        <li><b>03</b> 15-Minute Auto Timer &mdash; One zone per session</li>
        <li><b>04</b> Conductive Gel Starter &mdash; 8 oz botanical firming gel</li>
    </ul>
    <div class="hero__actions">
      <a class="btn btn--primary" href="{{ section.settings.cta_link | default: '/products/sculptwave-40khz-ultrasonic-body-sculptor' }}">Unlock the complete set &mdash; {{ section.settings.price | default: 109 }}</a>
      <a class="btn btn--ghost" href="#bundles">Compare 3 tiers</a>
    </div>
    <p class="hero__meta">Ships from {{ shop.name }} &bull; 60-day guarantee &bull; Subscribe &amp; save 20%</p>
  </div>
</section>
{% schema %}
{
  "name": "3D exploded hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "SculptWave 40kHz Ultrasonic Body Sculptor" },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "A 40kHz ultrasonic head with a 3-intensity dial, a 15-minute auto session timer, and a conductive gel starter." },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "number", "id": "price", "label": "Hero price (USD)", "default": 109 }
  ]
}
{% endschema %}
