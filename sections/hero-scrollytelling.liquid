<section class="hero" data-hero data-store="store-14-lumen-desk">
  <div class="hero__stage" data-hero-stage>
    <div class="hero__grid" aria-hidden="true"></div>
    <div class="hero__isometric" data-isometric>
      <div class="layer" data-depth="34" style="--i: 0">
        <span class="layer__index">01</span>
        <span class="layer__name">CRI 98+ LED Bar</span>
        <span class="layer__note">45 cm, 2700K-6500K</span>
      </div>
      <div class="layer" data-depth="68" style="--i: 1">
        <span class="layer__index">02</span>
        <span class="layer__name">Asymmetric Optic</span>
        <span class="layer__note">Zero screen glare</span>
      </div>
      <div class="layer" data-depth="102" style="--i: 2">
        <span class="layer__index">03</span>
        <span class="layer__name">USB-C Desk Dial</span>
        <span class="layer__note">Brightness and warmth</span>
      </div>
      <div class="layer" data-depth="136" style="--i: 3">
        <span class="layer__index">04</span>
        <span class="layer__name">Counterweight Mount</span>
        <span class="layer__note">Fits 0.4-2.2 in monitors</span>
      </div>
    </div>
  </div>
  <div class="hero__copy">
    <p class="hero__eyebrow">High-CRI asymmetric desk lighting and cable systems for deep work.</p>
    <h1 class="hero__title">{{ section.settings.heading | default: "LumenDesk CRI 98+ Asymmetric Monitor Light Bar" }}</h1>
    <p class="hero__lede">{{ section.settings.lede | default: "A 45 cm asymmetric light bar at CRI 98+ with no screen glare, five colour temperatures, and a USB-C dial." }}</p>
    <ul class="hero__callouts">
        <li><b>01</b> CRI 98+ LED Bar &mdash; 45 cm, 2700K-6500K</li>
        <li><b>02</b> Asymmetric Optic &mdash; Zero screen glare</li>
        <li><b>03</b> USB-C Desk Dial &mdash; Brightness and warmth</li>
        <li><b>04</b> Counterweight Mount &mdash; Fits 0.4-2.2 in monitors</li>
    </ul>
    <div class="hero__actions">
      <a class="btn btn--primary" href="{{ section.settings.cta_link | default: '/products/lumendesk-cri-98-asymmetric-monitor-light-bar' }}">Unlock the complete set &mdash; {{ section.settings.price | default: 64 }}</a>
      <a class="btn btn--ghost" href="#bundles">Compare 3 tiers</a>
    </div>
    <p class="hero__meta">Ships from {{ shop.name }} &bull; 60-day guarantee &bull; Subscribe &amp; save 20%</p>
  </div>
</section>
{% schema %}
{
  "name": "3D exploded hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "LumenDesk CRI 98+ Asymmetric Monitor Light Bar" },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "A 45 cm asymmetric light bar at CRI 98+ with no screen glare, five colour temperatures, and a USB-C dial." },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "number", "id": "price", "label": "Hero price (USD)", "default": 64 }
  ]
}
{% endschema %}
