<section class="hero" data-hero data-store="store-05-wonder-hive">
  <div class="hero__stage" data-hero-stage>
    <div class="hero__grid" aria-hidden="true"></div>
    <div class="hero__isometric" data-isometric>
      <div class="layer" data-depth="34" style="--i: 0">
        <span class="layer__index">01</span>
        <span class="layer__name">Five 10-Frame Boards</span>
        <span class="layer__note">Laminated, wipe-clean</span>
      </div>
      <div class="layer" data-depth="68" style="--i: 1">
        <span class="layer__index">02</span>
        <span class="layer__name">120 Silicone Counters</span>
        <span class="layer__note">6 colours, 5 themes</span>
      </div>
      <div class="layer" data-depth="102" style="--i: 2">
        <span class="layer__index">03</span>
        <span class="layer__name">40 Task Cards</span>
        <span class="layer__note">Subitising to place value</span>
      </div>
      <div class="layer" data-depth="136" style="--i: 3">
        <span class="layer__index">04</span>
        <span class="layer__name">Cotton Carry Bag</span>
        <span class="layer__note">Machine washable</span>
      </div>
    </div>
  </div>
  <div class="hero__copy">
    <p class="hero__eyebrow">Ten-frame sensory math and STEM kits for classrooms and kitchen tables.</p>
    <h1 class="hero__title">{{ section.settings.heading | default: "WonderHive 10-Frame Sensory Math Kit" }}</h1>
    <p class="hero__lede">{{ section.settings.lede | default: "Ten frames, 120 silicone counters, and 40 double-sided task cards in a cotton drawstring bag." }}</p>
    <ul class="hero__callouts">
        <li><b>01</b> Five 10-Frame Boards &mdash; Laminated, wipe-clean</li>
        <li><b>02</b> 120 Silicone Counters &mdash; 6 colours, 5 themes</li>
        <li><b>03</b> 40 Task Cards &mdash; Subitising to place value</li>
        <li><b>04</b> Cotton Carry Bag &mdash; Machine washable</li>
    </ul>
    <div class="hero__actions">
      <a class="btn btn--primary" href="{{ section.settings.cta_link | default: '/products/wonderhive-10-frame-sensory-math-kit' }}">Unlock the complete set &mdash; {{ section.settings.price | default: 34 }}</a>
      <a class="btn btn--ghost" href="#bundles">Compare 3 tiers</a>
    </div>
    <p class="hero__meta">Ships from {{ shop.name }} &bull; 60-day guarantee &bull; Subscribe &amp; save 20%</p>
  </div>
</section>
{% schema %}
{
  "name": "3D exploded hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "WonderHive 10-Frame Sensory Math Kit" },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "Ten frames, 120 silicone counters, and 40 double-sided task cards in a cotton drawstring bag." },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "number", "id": "price", "label": "Hero price (USD)", "default": 34 }
  ]
}
{% endschema %}
