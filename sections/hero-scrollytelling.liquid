<section class="hero" data-hero data-store="store-11-nomad-carry">
  <div class="hero__stage" data-hero-stage>
    <div class="hero__grid" aria-hidden="true"></div>
    <div class="hero__isometric" data-isometric>
      <div class="layer" data-depth="34" style="--i: 0">
        <span class="layer__index">01</span>
        <span class="layer__name">40L Carry-On Shell</span>
        <span class="layer__note">Fits 22x14x9 airline sizers</span>
      </div>
      <div class="layer" data-depth="68" style="--i: 1">
        <span class="layer__index">02</span>
        <span class="layer__name">Vacuum Compression Chamber</span>
        <span class="layer__note">Removes 60% of air</span>
      </div>
      <div class="layer" data-depth="102" style="--i: 2">
        <span class="layer__index">03</span>
        <span class="layer__name">USB-C Micro Pump</span>
        <span class="layer__note">70-second cycle</span>
      </div>
      <div class="layer" data-depth="136" style="--i: 3">
        <span class="layer__index">04</span>
        <span class="layer__name">Modular Packing Cubes</span>
        <span class="layer__note">Three cubes, two pouches</span>
      </div>
    </div>
  </div>
  <div class="hero__copy">
    <p class="hero__eyebrow">Vacuum-compression luggage and modular packing for carry-on-only travel.</p>
    <h1 class="hero__title">{{ section.settings.heading | default: "NomadCarry AirVac 40L Vacuum Backpack + Pump" }}</h1>
    <p class="hero__lede">{{ section.settings.lede | default: "A 40L carry-on backpack with vacuum compression, a USB-C pump, and a modular packing cube set." }}</p>
    <ul class="hero__callouts">
        <li><b>01</b> 40L Carry-On Shell &mdash; Fits 22x14x9 airline sizers</li>
        <li><b>02</b> Vacuum Compression Chamber &mdash; Removes 60% of air</li>
        <li><b>03</b> USB-C Micro Pump &mdash; 70-second cycle</li>
        <li><b>04</b> Modular Packing Cubes &mdash; Three cubes, two pouches</li>
    </ul>
    <div class="hero__actions">
      <a class="btn btn--primary" href="{{ section.settings.cta_link | default: '/products/nomadcarry-airvac-40l-vacuum-backpack-pump' }}">Unlock the complete set &mdash; {{ section.settings.price | default: 119 }}</a>
      <a class="btn btn--ghost" href="#bundles">Compare 3 tiers</a>
    </div>
    <p class="hero__meta">Ships from {{ shop.name }} &bull; 60-day guarantee &bull; Subscribe &amp; save 20%</p>
  </div>
</section>
{% schema %}
{
  "name": "3D exploded hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "NomadCarry AirVac 40L Vacuum Backpack + Pump" },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "A 40L carry-on backpack with vacuum compression, a USB-C pump, and a modular packing cube set." },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "number", "id": "price", "label": "Hero price (USD)", "default": 119 }
  ]
}
{% endschema %}
