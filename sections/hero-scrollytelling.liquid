<section class="hero" data-hero data-store="store-07-aether-sleep">
  <div class="hero__stage" data-hero-stage>
    <div class="hero__grid" aria-hidden="true"></div>
    <div class="hero__isometric" data-isometric>
      <div class="layer" data-depth="34" style="--i: 0">
        <span class="layer__index">01</span>
        <span class="layer__name">3D Contoured Silk Mask</span>
        <span class="layer__note">22-momme, zero lash pressure</span>
      </div>
      <div class="layer" data-depth="68" style="--i: 1">
        <span class="layer__index">02</span>
        <span class="layer__name">Mulberry Silk Pillowcase</span>
        <span class="layer__note">22-momme, hidden zip</span>
      </div>
      <div class="layer" data-depth="102" style="--i: 2">
        <span class="layer__index">03</span>
        <span class="layer__name">Contoured Ear Plug Pair</span>
        <span class="layer__note">28 dB, side-sleeper shaped</span>
      </div>
      <div class="layer" data-depth="136" style="--i: 3">
        <span class="layer__index">04</span>
        <span class="layer__name">Travel Sleep Case</span>
        <span class="layer__note">Fits the whole system</span>
      </div>
    </div>
  </div>
  <div class="hero__copy">
    <p class="hero__eyebrow">Silk sleep systems and a circadian protocol, not just another mask.</p>
    <h1 class="hero__title">{{ section.settings.heading | default: "Aether 3D Contoured 22-Momme Silk Sleep System" }}</h1>
    <p class="hero__lede">{{ section.settings.lede | default: "A 3D contoured silk mask, a mulberry silk pillowcase, and an ear-plug pair in a travel case." }}</p>
    <ul class="hero__callouts">
        <li><b>01</b> 3D Contoured Silk Mask &mdash; 22-momme, zero lash pressure</li>
        <li><b>02</b> Mulberry Silk Pillowcase &mdash; 22-momme, hidden zip</li>
        <li><b>03</b> Contoured Ear Plug Pair &mdash; 28 dB, side-sleeper shaped</li>
        <li><b>04</b> Travel Sleep Case &mdash; Fits the whole system</li>
    </ul>
    <div class="hero__actions">
      <a class="btn btn--primary" href="{{ section.settings.cta_link | default: '/products/aether-3d-contoured-22-momme-silk-sleep-system' }}">Unlock the complete set &mdash; {{ section.settings.price | default: 44 }}</a>
      <a class="btn btn--ghost" href="#bundles">Compare 3 tiers</a>
    </div>
    <p class="hero__meta">Ships from {{ shop.name }} &bull; 60-day guarantee &bull; Subscribe &amp; save 20%</p>
  </div>
</section>
{% schema %}
{
  "name": "3D exploded hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Aether 3D Contoured 22-Momme Silk Sleep System" },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "A 3D contoured silk mask, a mulberry silk pillowcase, and an ear-plug pair in a travel case." },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "number", "id": "price", "label": "Hero price (USD)", "default": 44 }
  ]
}
{% endschema %}
