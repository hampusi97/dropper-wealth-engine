<section class="hero" data-hero data-store="store-10-terra-paw">
  <div class="hero__stage" data-hero-stage>
    <div class="hero__grid" aria-hidden="true"></div>
    <div class="hero__isometric" data-isometric>
      <div class="layer" data-depth="34" style="--i: 0">
        <span class="layer__index">01</span>
        <span class="layer__name">4-inch Memory Foam Base</span>
        <span class="layer__note">CertiPUR-US certified</span>
      </div>
      <div class="layer" data-depth="68" style="--i: 1">
        <span class="layer__index">02</span>
        <span class="layer__name">Bolster Rim</span>
        <span class="layer__note">Head and spine support</span>
      </div>
      <div class="layer" data-depth="102" style="--i: 2">
        <span class="layer__index">03</span>
        <span class="layer__name">Waterproof Liner</span>
        <span class="layer__note">Removable, washable</span>
      </div>
      <div class="layer" data-depth="136" style="--i: 3">
        <span class="layer__index">04</span>
        <span class="layer__name">Washable Cover</span>
        <span class="layer__note">Linen weave, hidden zip</span>
      </div>
    </div>
  </div>
  <div class="hero__copy">
    <p class="hero__eyebrow">Human-grade orthopedic beds and calming enrichment for anxious dogs.</p>
    <h1 class="hero__title">{{ section.settings.heading | default: "TerraPaw Human-Grade Orthopedic Bolster Dog Bed" }}</h1>
    <p class="hero__lede">{{ section.settings.lede | default: "A 4-inch CertiPUR-US memory foam base with a bolster rim, a waterproof liner, and a washable cover." }}</p>
    <ul class="hero__callouts">
        <li><b>01</b> 4-inch Memory Foam Base &mdash; CertiPUR-US certified</li>
        <li><b>02</b> Bolster Rim &mdash; Head and spine support</li>
        <li><b>03</b> Waterproof Liner &mdash; Removable, washable</li>
        <li><b>04</b> Washable Cover &mdash; Linen weave, hidden zip</li>
    </ul>
    <div class="hero__actions">
      <a class="btn btn--primary" href="{{ section.settings.cta_link | default: '/products/terrapaw-human-grade-orthopedic-bolster-dog-bed' }}">Unlock the complete set &mdash; {{ section.settings.price | default: 74 }}</a>
      <a class="btn btn--ghost" href="#bundles">Compare 3 tiers</a>
    </div>
    <p class="hero__meta">Ships from {{ shop.name }} &bull; 60-day guarantee &bull; Subscribe &amp; save 20%</p>
  </div>
</section>
{% schema %}
{
  "name": "3D exploded hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "TerraPaw Human-Grade Orthopedic Bolster Dog Bed" },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "A 4-inch CertiPUR-US memory foam base with a bolster rim, a waterproof liner, and a washable cover." },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "number", "id": "price", "label": "Hero price (USD)", "default": 74 }
  ]
}
{% endschema %}
