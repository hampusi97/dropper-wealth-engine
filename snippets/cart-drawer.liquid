<div class="cart-drawer" data-cart-drawer aria-hidden="true" role="dialog" aria-modal="true" aria-label="Cart">
  <div class="cart-drawer__overlay" data-cart-close></div>
  <div class="cart-drawer__panel">
    <header class="cart-drawer__head">
      <h2>Your bag</h2>
      <button type="button" class="cart-drawer__x" data-cart-close aria-label="Close cart">&times;</button>
    </header>

    <div class="progress" data-progress>
      <p class="progress__label" data-progress-label>Add $75 for free shipping</p>
      <div class="progress__bar"><div class="progress__fill" data-progress-fill style="width:0%"></div></div>
      <ul class="progress__milestones">
        <li class="ms" data-threshold="75"><span class="ms__amt">$75</span><span class="ms__reward">Free Shipping</span><span class="ms__check" aria-hidden="true">○</span></li>
        <li class="ms" data-threshold="140"><span class="ms__amt">$140</span><span class="ms__reward">Extra 15% Off</span><span class="ms__check" aria-hidden="true">○</span></li>
        <li class="ms" data-threshold="210"><span class="ms__amt">$210</span><span class="ms__reward">Free Vacuum Packing Cube Set</span><span class="ms__check" aria-hidden="true">○</span></li>
      </ul>
    </div>

    <div class="cart-drawer__items" data-cart-items></div>

    <div class="bump" data-bump>
      <div class="bump__body">
        <p class="bump__tag">Instant digital add-on &bull; $0 cost to ship</p>
        <p class="bump__title">One-Bag Global Minimalist Packing Checklist &amp; Tracker</p>
        <p class="bump__desc">A one-bag packing system: the 34-item carry-on checklist, a 7-day laundry loop, and a trip tracker in Notion.</p>
        <p class="bump__meta">PDF + Notion template &bull; 22 pages &bull; delivered by email in seconds</p>
      </div>
      <button type="button" class="btn btn--primary bump__add" data-bump-add data-bump-variant="{{ settings.digital_variant_id }}" data-bump-price="9">
        Add for $9
      </button>
      <p class="bump__done" data-bump-done hidden>Added to your order ✓</p>
    </div>

    <footer class="cart-drawer__foot">
      <p class="cart-drawer__points">VIP points this order: <b data-vip-points>0</b> <span>(10 pts / $1)</span></p>
      <div class="cart-drawer__total"><span>Subtotal</span><b data-cart-subtotal>$0.00</b></div>
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <button type="submit" name="checkout" class="btn btn--primary cart-drawer__checkout">Checkout</button>
      </form>
      <p class="cart-drawer__note">Taxes and shipping calculated at checkout. 60-day guarantee.</p>
    </footer>
  </div>
</div>
